<Page
    x:Class="Arcanoid.MenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Arcanoid"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    

    <Grid>
        <Grid.Background>
            <ImageBrush x:Name="Background" ImageSource="/Assets/Background/background.jpg"></ImageBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource MyButtonStyle}" x:Name="btnExit" Grid.Row="0" Grid.Column="13" Grid.ColumnSpan="1" Grid.RowSpan="2">
            <Image x:Name="imgExit" Source="/Assets/Buttons/ExitG.png" PointerEntered="img_PointerEntered" PointerExited="img_PointerExited" PointerPressed="imgExit_PointerPressed"></Image>
        </Button>
        <Button Style="{StaticResource MyButtonStyle}" x:Name="BtnSettings" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" Grid.RowSpan="2">
            <Image x:Name="imgSettings" Source="/Assets/Buttons/SettingsO.png" PointerEntered="img_PointerEntered" PointerExited="img_PointerExited"></Image>
        </Button>
        <Button Style="{StaticResource MyButtonStyle}" x:Name="BtnPlay" Grid.Row="6" Grid.Column="6" Grid.ColumnSpan="3" Grid.RowSpan="3">
            <Image x:Name="imgPlay" Source="/Assets/Buttons/PlayO.png" PointerEntered="img_PointerEntered" PointerExited="img_PointerExited"></Image>
        </Button>
        <Button Style="{StaticResource MyButtonStyle}" x:Name="BtnHelp" Grid.Row="9" Grid.Column="4" Grid.ColumnSpan="1" Grid.RowSpan="2">
            <Image x:Name="imgHelp" Source="/Assets/Buttons/HelpO.png" PointerEntered="img_PointerEntered" PointerExited="img_PointerExited"></Image>
        </Button>
        <Button Style="{StaticResource MyButtonStyle}" x:Name="BtnMusic" Grid.Row="9" Grid.Column="5" Grid.ColumnSpan="1" Grid.RowSpan="2">
            <Image x:Name="imgMusic" Source="/Assets/Buttons/MusicO.png" PointerEntered="img_PointerEntered" PointerExited="img_PointerExited" PointerPressed="imgMusic_PointerPressed"></Image>
        </Button>
        <Button Style="{StaticResource MyButtonStyle}" x:Name="BtnAccaunt" Grid.Row="9" Grid.Column="6" Grid.ColumnSpan="1" Grid.RowSpan="2">
            <Image x:Name="imgAccaunt" Source="/Assets/Buttons/ProfileO.png" PointerEntered="img_PointerEntered" PointerExited="img_PointerExited" PointerPressed="imgAccaunt_PointerPressed"></Image>
        </Button>
        <Button Style="{StaticResource MyButtonStyle}" x:Name="BtnLeader" Grid.Row="9" Grid.Column="7" Grid.ColumnSpan="1" Grid.RowSpan="2">
            <Image x:Name="imgLeader" Source="/Assets/Buttons/LeaderO.png" PointerEntered="img_PointerEntered" PointerExited="img_PointerExited"></Image>
        </Button>
        <Button Style="{StaticResource MyButtonStyle}" x:Name="BtnShop" Grid.Row="9" Grid.Column="8" Grid.ColumnSpan="1" Grid.RowSpan="2">
            <Image x:Name="imgShop" Source="/Assets/Buttons/ShopO.png" PointerEntered="img_PointerEntered" PointerExited="img_PointerExited"></Image>
        </Button>
            <Button Style="{StaticResource MyButtonStyle}" x:Name="BtnLevels" Grid.Row="9" Grid.Column="9" Grid.ColumnSpan="1" Grid.RowSpan="2">
                <Image x:Name="imgLevel" Source="/Assets/Buttons/LevelsO.png" PointerEntered="img_PointerEntered" PointerExited="img_PointerExited" PointerPressed="imgLevel_PointerPressed"></Image>
            </Button>
        <Grid x:Name="popupGrid" Background="DodgerBlue" Grid.Row="3" Grid.Column="3" Grid.RowSpan="9" Grid.ColumnSpan="8" Opacity="1" BorderBrush="Blue" BorderThickness="10" CornerRadius="120" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Viewbox Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="10" Grid.RowSpan="4">
                <TextBlock Text="Exit the game?" HorizontalAlignment="Center" FontSize="755" Foreground="White" FontFamily="Broadway" FontWeight="Bold"></TextBlock>
            </Viewbox>
            <Button Style="{StaticResource MyButtonStyle}" x:Name="btnPopNo" Grid.Row="5" Grid.Column="8" Grid.ColumnSpan="4" Grid.RowSpan="3">
                <Image x:Name="imgPopExit" Source="/Assets/Buttons/ExitO.png" PointerEntered="img_PointerEntered"  PointerExited="img_PointerExited" PointerPressed="imgPopNo_PointerPressed"></Image>
            </Button>
            <Button Style="{StaticResource MyButtonStyle}" x:Name="BtnPopYes" Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="4" Grid.RowSpan="3">
                <Image x:Name="imgYes" Source="/Assets/Buttons/YesO.png" PointerEntered="img_PointerEntered" PointerExited="img_PointerExited" PointerPressed="imgYes_PointerPressed"></Image>
            </Button>
        </Grid>
        <Grid x:Name="popupGridMusic" Background="DodgerBlue" Grid.Row="3" Grid.Column="4" Grid.RowSpan="8" Grid.ColumnSpan="6" Opacity="1" BorderBrush="Blue" BorderThickness="10" CornerRadius="70" Visibility="Collapsed">
                <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource MyButtonStyle}" x:Name="BtnYes" Grid.Row="8" Grid.Column="5" Grid.ColumnSpan="2" Grid.RowSpan="2">
                <Image x:Name="imgYesPop" Source="/Assets/Buttons/YesO.png" PointerEntered="img_PointerEntered"  PointerExited="img_PointerExited" PointerPressed="imgBack_PointerPressed"></Image>
            </Button>
            <Viewbox Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="10" Grid.RowSpan="2">
                <TextBlock Text="Sound Control" FontSize="45" Foreground="White" Grid.RowSpan="2" VerticalAlignment="Stretch" FontFamily="Broadway" FontWeight="Bold"></TextBlock>
            </Viewbox>
            <ToggleSwitch x:Name="BackgroundMusic" IsOn="False" OnContent="Music On" OffContent="Music Off" Toggled="BackgroundMusic_Toggled" FontSize="40" Foreground="White" VerticalAlignment="Stretch" FontFamily="Broadway" FontWeight="Bold" Grid.Column="2" Grid.Row="2" Grid.RowSpan="2" Grid.ColumnSpan="6"></ToggleSwitch>
            <ToggleSwitch x:Name="SoundEffects" IsOn="False" OnContent="Sound Effects On" OffContent="Sound Effects off" Toggled="SoundEffects_Toggled"  FontSize="40" Foreground="White" Grid.RowSpan="2" Grid.ColumnSpan="6" VerticalAlignment="Stretch" FontFamily="Broadway" FontWeight="Bold" Grid.Column="2" Grid.Row="3"></ToggleSwitch>
            <Slider x:Name="BackgroundVolumeSlider" ValueChanged="BackgroundVolumeSlider_ValueChanged" Value="50" Maximum="100" Header="Background Sound" Grid.ColumnSpan="8" Grid.RowSpan="2" Grid.Row="4" Grid.Column="2" FontSize="40" Foreground="White" VerticalAlignment="Stretch" FontFamily="Broadway" FontWeight="Bold"></Slider>
            <Slider x:Name="SoundEffectsVolumeSlider" ValueChanged="SoundEffectsVolumeSlider_ValueChanged" Value="50" Maximum="100" Header="SoundEffects Volume" Grid.ColumnSpan="8" Grid.RowSpan="2" Grid.Row="6" Grid.Column="2" FontSize="40" Foreground="White" VerticalAlignment="Stretch" FontFamily="Broadway" FontWeight="Bold"></Slider>


        </Grid>
    </Grid>
</Page>
